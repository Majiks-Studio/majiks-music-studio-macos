{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majiks-music-studio-pro/contracts/gen-protocol.schemas.json",
  "title": "Gen Protocol v1 request/response schemas",
  "description": "Plain-JSON mirror of the component schemas in gen-protocol.v1.yaml's components.schemas (OpenAPI 3.1 components.schemas ARE JSON Schema 2020-12, so this is not a second definition of the contract, it is the same schemas kept as standalone JSON so neither conformance runner needs a YAML parser as a dependency. gen-protocol.v1.yaml is authoritative prose + operation wiring; if the two ever disagree, gen-protocol.v1.yaml wins and this file is out of date and must be regenerated by hand (see fixtures/tools/generate_fixtures.py). Field-by-field mapping onto the existing Python backend is in gen-protocol-mapping.md, not repeated here.",

  "$defs": {

    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },

    "assetHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },

    "engineRoute": {
      "type": "string",
      "enum": ["local-mlx", "remote-ace", "gen-node", "uc-cloud"],
      "description": "The four engine routes named in 02-ARCH section 1. The Swift ServerPool chooses a route when omitted from a request."
    },

    "stemScope": {
      "type": "string",
      "enum": ["all-stems", "vocals", "drums", "bass", "other"]
    },

    "qualityRung": {
      "type": "string",
      "enum": ["draft", "standard", "full"],
      "description": "draft=acestep-v15-turbo. standard=acestep-v15-quality (step default not yet observed in any shipped call site; open question, see gen-protocol-mapping.md). full=acestep-v15-base."
    },

    "errorBody": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "description": "Matches the existing _structured_error() code vocabulary verbatim, e.g. OUT_OF_MEMORY, CHECKPOINT_MISSING, FILE_NOT_FOUND, CANCELLED, DISK_FULL, PYTHON_CRASH, REMOTE_GENERATION_FAILED, REMOTE_SERVER_ERROR, AUDIO_ANALYSIS_FAILED. Not a closed enum here: the backend's category list is open-ended (see gen-protocol-mapping.md)."
        },
        "message": { "type": "string", "minLength": 1 },
        "fix": { "type": "string" },
        "detail": { "type": "string" },
        "step": { "type": "string" }
      }
    },

    "engineIdentity": {
      "type": "object",
      "required": ["model", "device"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "steps": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "device": { "type": "string", "enum": ["mlx", "mps", "cuda", "cpu", "remote"] }
      }
    },

    "artifact": {
      "type": "object",
      "required": ["kind", "path", "contentHash"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["mix", "vocals", "drums", "bass", "other"] },
        "path": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/assetHash" }
      }
    },

    "progressEvent": {
      "type": "object",
      "required": ["jobId", "stage", "percent", "message"],
      "additionalProperties": false,
      "properties": {
        "jobId": { "$ref": "#/$defs/ulid" },
        "stage": { "type": "string", "minLength": 1 },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "message": { "type": "string" },
        "variant": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] }
      },
      "description": "Normalized shape of the existing wire notification {\"jsonrpc\":\"2.0\",\"method\":\"progress\",\"params\":{\"id\":...,\"stage\":...,\"percent\":...,\"message\":...,\"variant\":...}}: jobId here is params.id on the wire. See gen-protocol-mapping.md."
    },

    "terminalState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "jobId", "artifacts", "engineIdentity"],
          "additionalProperties": false,
          "properties": {
            "state": { "const": "done" },
            "jobId": { "$ref": "#/$defs/ulid" },
            "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
            "engineIdentity": { "$ref": "#/$defs/engineIdentity" },
            "latencySeconds": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["state", "jobId", "error"],
          "additionalProperties": false,
          "properties": {
            "state": { "const": "failed" },
            "jobId": { "$ref": "#/$defs/ulid" },
            "error": { "$ref": "#/$defs/errorBody" }
          }
        },
        {
          "type": "object",
          "required": ["state", "jobId"],
          "additionalProperties": false,
          "properties": {
            "state": { "const": "cancelled" },
            "jobId": { "$ref": "#/$defs/ulid" }
          }
        }
      ]
    },

    "submitResponse": {
      "type": "object",
      "required": ["jobId"],
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "$ref": "#/$defs/ulid",
          "description": "Always equal to the requestId the caller supplied in the request body: job_id is not a second identifier minted by the server, it is the caller's idempotency key echoed back. See gen-protocol-mapping.md."
        }
      }
    },

    "capabilitiesResponse": {
      "type": "object",
      "required": ["endpoints"],
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["route", "ops", "models", "concurrentSlots"],
            "additionalProperties": false,
            "properties": {
              "route": { "$ref": "#/$defs/engineRoute" },
              "ops": { "type": "array", "items": { "type": "string" } },
              "models": { "type": "array", "items": { "type": "string" } },
              "concurrentSlots": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },

    "generateRequest": {
      "type": "object",
      "required": ["requestId", "caption"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "caption": { "type": "string", "minLength": 1 },
        "lyrics": { "type": "string" },
        "durationSeconds": { "type": "number", "minimum": 30, "maximum": 600, "default": 150 },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 300 },
        "key": { "type": "string" },
        "timeSig": { "type": "string", "default": "4" },
        "vocalLanguage": { "type": "string" },
        "seed": { "type": "integer" },
        "model": { "type": "string" },
        "steps": { "type": "integer", "minimum": 1, "maximum": 200 },
        "nVariants": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 }
      }
    },

    "reviseRequest": {
      "type": "object",
      "required": ["requestId", "sourceAudioRef", "regionStartSeconds", "regionEndSeconds", "instruction"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "sourceAudioRef": { "type": "string", "minLength": 1 },
        "regionStartSeconds": { "type": "number", "minimum": 0 },
        "regionEndSeconds": { "type": "number", "description": "-1 means end of track, matching the backend's repainting_end sentinel." },
        "instruction": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/stemScope", "default": "all-stems" },
        "seed": { "type": "integer" },
        "variants": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 }
      }
    },

    "extendRequest": {
      "type": "object",
      "required": ["requestId", "sourceAudioRef", "addedDurationSeconds"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "sourceAudioRef": { "type": "string", "minLength": 1 },
        "addedDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "instruction": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },

    "layerRequest": {
      "type": "object",
      "required": ["requestId", "instruction"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "contextAudioRef": { "type": "string" },
        "instruction": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },

    "retakeRequest": {
      "type": "object",
      "required": ["requestId", "sourceTakeId"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "sourceTakeId": { "type": "string", "minLength": 1 },
        "regionStartSeconds": { "type": "number", "minimum": 0 },
        "regionEndSeconds": { "type": "number" },
        "seed": { "type": "integer" }
      },
      "description": "regionStartSeconds/regionEndSeconds both present means a region retake (routes to repaint); both absent means a whole-song retake (routes to generate). One-present-one-absent is invalid (see conformance rule in gen-protocol-mapping.md)."
    },

    "autocompleteRequest": {
      "type": "object",
      "required": ["requestId", "sourceAudioRef", "caption"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "sourceAudioRef": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" }
      }
    },

    "coverRequest": {
      "type": "object",
      "required": ["requestId", "referenceAudioRef", "caption"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "route": { "$ref": "#/$defs/engineRoute" },
        "referenceAudioRef": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "coverStrength": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "seed": { "type": "integer" }
      }
    },

    "separateRequest": {
      "type": "object",
      "required": ["requestId", "sourceAudioRef"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "sourceAudioRef": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "enum": ["demucs", "ace-extract"], "default": "demucs" },
        "instruction": {
          "type": "string",
          "description": "Only meaningful when engine=ace-extract: comma-separated stems to isolate, e.g. 'vocals, drums'. Ignored for engine=demucs, which always produces all 4 stems."
        }
      }
    },

    "analyzeRequest": {
      "type": "object",
      "required": ["requestId", "sourceAudioRef"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "sourceAudioRef": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["full", "fast"], "default": "full" },
        "existingCaption": { "type": "string" },
        "existingTitle": { "type": "string" }
      }
    },

    "analyzeResponse": {
      "type": "object",
      "required": ["bpm", "key", "duration"],
      "additionalProperties": false,
      "properties": {
        "bpm": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "key": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "duration": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "downbeats": {
          "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "number" } }],
          "description": "NOT YET PRODUCED by the Python backend as of v3.3.0 (no downbeat detection exists in ace_generator.py or rpc_server.py). Always null until a later lane implements it. See gen-protocol-mapping.md."
        },
        "loudnessLufs": {
          "oneOf": [{ "type": "null" }, { "type": "number" }],
          "description": "NOT YET PRODUCED by the Python backend. Planned to live in the Rust engine's media crate (02-ARCH section 3: 'analysis, loudness'), not Python. Always null until that lane ships. See gen-protocol-mapping.md."
        },
        "caption": { "type": "string" },
        "lyrics": { "type": "string" },
        "language": { "type": "string" },
        "timeSig": { "type": "string" },
        "genre": { "type": "string" },
        "style": { "type": "string" }
      }
    },

    "finalizeRequest": {
      "type": "object",
      "required": ["requestId", "draftTakeId", "targetQualityRung", "request"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/ulid" },
        "draftTakeId": { "type": "string", "minLength": 1 },
        "targetQualityRung": { "$ref": "#/$defs/qualityRung" },
        "request": {
          "$ref": "#/$defs/reviseRequest",
          "description": "Same request shape as the revise request that produced draftTakeId: identical sourceAudioRef/region/instruction/scope. Only the model+steps rung changes; seed is reused from the draft for lineage fidelity (see gen-protocol-mapping.md)."
        }
      }
    }
  }
}
