# /etc/acestep-gate.env: settings for this host. Copy and edit; do not commit your real one.

# Where the gate listens. Bind to a private interface (LAN / VPN) unless you put TLS in front.
GATE_HOST=0.0.0.0
GATE_PORT=8010

# Your ACE-Step 1.5 checkout and the Python that runs it (needs fastapi, uvicorn, httpx too).
GATE_ACE_DIR=/opt/ACE-Step-1.5
GATE_ACE_PYTHON=/opt/ACE-Step-1.5/.venv/bin/python
# Localhost port ACE-Step itself listens on (never exposed).
GATE_ACE_PORT=8020
# GPU index for CUDA_VISIBLE_DEVICES.
GATE_GPU=0
# Load ACE-Step's 5Hz LM too (needs much more VRAM).
GATE_ACE_INIT_LLM=false
GATE_ACE_LOG=/opt/acestep-gate/acestep.log

# Key file (hashes only; manage with gate_keys.py).
GATE_KEYS_FILE=/opt/acestep-gate/keys.json

# Unload ACE-Step after this many idle seconds.
GATE_IDLE_SECONDS=600
# Max unfinished jobs per key.
GATE_MAX_ACTIVE_PER_KEY=4
